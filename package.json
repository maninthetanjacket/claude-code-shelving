{
  "name": "claude-code-shelving",
  "version": "0.1.0",
  "description": "Deliberate context-shelving for Claude Code: model-driven compress/decompress with cache-stable proxy substitution. Manual mode by default.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx tests/*.test.ts",
